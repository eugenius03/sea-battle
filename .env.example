# ==========================================
# Sea Battle - Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your real secrets:
#   cp .env.example .env
#
# NOTE: .env is ignored by Git and should NEVER be committed!

# --- Transactional Email (Resend) ---
# Grab your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# --- Authentication & JWT ---
# 256-bit base64/hex secret for signing JWTs
JWT_SECRET=AvaBwBD0xSg1ZlAop3WyS3XxdvjRJ9ezTAKjYQ0dak2
ACCESS_TOKEN_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/sea_battle_db
DB_USERNAME=user
DB_PASSWORD=password

# --- Cache & Matchmaking (Redis) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- Application Ports & Domains ---
PORT=8080
WEBSOCKET_ALLOWED_ORIGINS=*
APP_DOMAIN=https://seabattle.lol
